{
    "name": "DS_CSV_Landing",
    "type": "Microsoft.DataFactory/factories/datasets",
    "properties": {
        "description": "Generic parameterized CSV Dataset for external drops in landing container",
        "linkedServiceName": {
            "referenceName": "LS_ADLSGen2",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "DirectoryPath": {
                "type": "string"
            }
        },
        "type": "DelimitedText",
        "typeProperties": {
            "location": {
                "type": "AzureBlobFSLocation",
                "fileSystem": "landing",
                "folderPath": {
                    "value": "@dataset().DirectoryPath",
                    "type": "Expression"
                }
            },
            "columnDelimiter": ",",
            "escapeChar": "\\",
            "firstRowAsHeader": true,
            "quoteChar": "\""
        },
        "schema": []
    }
}
